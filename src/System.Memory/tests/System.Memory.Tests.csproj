<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetFrameworkCurrent)</TargetFramework>
    <!-- These tests intentionally verify that null-backed spans equal default. -->
    <NoWarn>$(NoWarn);CA2265</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\System\MutableDecimal.cs" Link="System\MutableDecimal.cs" />
    <Compile Include="$(CommonPath)tests\System\Buffers\NativeMemoryManager.cs" Link="Common\System\Buffers\NativeMemoryManager.cs" />
    <Compile Include="$(CommonPath)tests\System\Diagnostics\Tracing\TestEventListener.cs" Link="Common\System\Diagnostics\Tracing\TestEventListener.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\System.Memory.csproj" />
    <!-- net481 selects the net471 placeholder by default, but that target intentionally produces no assembly. -->
    <ProjectReference Include="..\..\System.ValueTuple\src\System.ValueTuple.csproj" AdditionalProperties="TargetFramework=net47" />
  </ItemGroup>

</Project>