<Project>
  <PropertyGroup>
    <PreReleaseVersionLabel>rtm</PreReleaseVersionLabel>
    <PreReleaseVersionIteration>
    </PreReleaseVersionIteration>
    <!-- Opt-out repo features -->
    <UseVSTestRunner>true</UseVSTestRunner>
    <UsingToolXliff>false</UsingToolXliff>
    <!-- Preserve the analyzer baseline used by the existing tests. -->
    <XUnitAnalyzersVersion>1.1.0</XUnitAnalyzersVersion>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Arcade dependencies -->
    <MicrosoftDotNetRemoteExecutorVersion>10.0.0-beta.26459.2</MicrosoftDotNetRemoteExecutorVersion>
    <MicrosoftDotNetXUnitExtensionsVersion>10.0.0-beta.26459.2</MicrosoftDotNetXUnitExtensionsVersion>
    <MicrosoftDotNetBuildTasksTargetFrameworkVersion>10.0.0-beta.26459.2</MicrosoftDotNetBuildTasksTargetFrameworkVersion>
    <MicrosoftDotNetBuildTasksTemplatingVersion>10.0.0-beta.26459.2</MicrosoftDotNetBuildTasksTemplatingVersion>
  </PropertyGroup>
</Project>
